run_step browser-bridge "Configuring the Windows login-browser bridge" "" configure_browser
if [[ "${step_status[browser-bridge]}" == success ]] && (( is_wsl == 1 )); then
    export BROWSER="$HOME/.local/bin/wsl-browser"
    export GH_BROWSER="$BROWSER"
fi
run_step github-cli "Checking or installing GitHub CLI" "" install_github_cli
run_step gh-aw "Checking or installing the gh-aw extension" "github-cli" install_gh_aw
