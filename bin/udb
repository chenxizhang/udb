    require_commands python3
    if ! python3 -c 'import venv, ensurepip' >/dev/null 2>&1; then
        install_packages python3-venv
    fi
    python3 -c 'import venv, ensurepip'
}

retire_missing_github_cli_source() {
    local source=/etc/apt/sources.list.d/github-cli.list
    local saved="$source.wsl-bootstrap.disabled" expected
    available gh && return
    [[ -f "$source" && ! -L "$source" ]] || return 0
    expected="deb [arch=$arch signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main"
    if [[ "$(<"$source")" != "$expected" ]]; then
        echo "Keeping the custom GitHub CLI apt source; it does not match the legacy bootstrap file."
        return
    fi
    require_step sudo
    [[ ! -e "$saved" && ! -L "$saved" ]] \
        || block_step "The legacy GitHub CLI apt backup already exists; inspect $source and $saved."
    sudo -n mv -- "$source" "$saved"
    echo "Disabled the exact legacy GitHub CLI apt source; missing gh will use a verified user-local binary."
}

download_verified_archive() {
    local url="$1" expected="$2" destination="$3" mirror="${4:-https://gh-proxy.org/$1}" limit="${5:-60}"
    local source actual status
    local -a sources=("$url" "$mirror")
    if (( china_mirror_requested == 1 )); then
        sources=("$mirror" "$url")
    fi
    for source in "${sources[@]}"; do
        echo "Downloading verified archive: $source (${limit}-second limit)"
        status=0
        curl --fail --show-error --location --connect-timeout 10 --max-time "$limit" \
            --speed-limit 1024 --speed-time 15 "$source" -o "$destination" || status=$?
        if (( status == 130 || status == 143 )); then
            exit "$status"
        fi
        if (( status != 0 )); then
            printf 'Archive download failed (exit %s): %s\n' "$status" "$source" >&2
            continue
        fi
        actual="$(sha256sum "$destination")"
        if [[ "${actual%% *}" == "$expected" ]]; then
            return
        fi
        printf 'Archive checksum mismatch: %s; refusing to extract it.\n' "$source" >&2
    done
    die "Both archive sources failed: $url and $mirror. Check HTTPS/proxy access; no unverified binary was installed."
}

install_github_cli() {
    if check_existing gh --version; then
        return
    fi
    require_commands curl tar sha256sum
    local version=2.103.3 checksum installation link="$HOME/.local/bin/gh" output
    case "$arch" in
        amd64) checksum=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d ;;
        arm64) checksum=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63 ;;
        *) die "Unsupported GitHub CLI architecture: $arch" ;;
    esac
    installation="$HOME/.local/share/wsl-bootstrap/gh-$version-linux-$arch"
    if [[ -e "$link" || -L "$link" ]]; then
        [[ -L "$link" && "$(readlink -m "$link")" == "$installation/gh" ]] \
            || die "Refusing to replace an existing user-local gh; inspect $link."
    fi
    if [[ -e "$installation" || -L "$installation" ]]; then
        [[ -d "$installation" && ! -L "$installation" ]] \
            || die "Unexpected managed GitHub CLI installation: $installation"
    else
        download_verified_archive \
            "https://github.com/cli/cli/releases/download/v$version/gh_${version}_linux_${arch}.tar.gz" \
            "$checksum" "$tmp/gh.tar.gz"
        mkdir -p "${installation%/*}"
        gh_stage="$(mktemp -d "${installation%/*}/.gh-stage.XXXXXXXX")"
        tar --extract --gzip --no-same-owner --strip-components=2 \
            --file "$tmp/gh.tar.gz" --directory "$gh_stage" "gh_${version}_linux_${arch}/bin/gh"
        output="$(timeout --kill-after=3s 10s "$gh_stage/gh" --version)" \
            || die "The downloaded GitHub CLI binary is not usable on this system."
        [[ "$output" == "gh version $version "* ]] || die "Unexpected downloaded GitHub CLI version."
        mv -T -- "$gh_stage" "$installation"
        gh_stage=""
    fi
    output="$(timeout --kill-after=3s 10s "$installation/gh" --version)" \
        || die "The managed GitHub CLI installation is incomplete; inspect $installation."
    [[ "$output" == "gh version $version "* ]] || die "Unexpected managed GitHub CLI version."
    mkdir -p "$HOME/.local/bin"
    if [[ ! -L "$link" ]]; then
        ln -s "$installation/gh" "$link"
    fi
    hash -r
    echo "Installed verified user-local GitHub CLI $version without apt or login changes."
}

write_gh_aw_retry() {
    local staged
    [[ ! -e "$report_directory/gh-aw-retry.sh" && ! -L "$report_directory/gh-aw-retry.sh" ]] \
        || { echo "Refusing to overwrite an existing gh-aw retry script." >&2; return 1; }
    staged="$(mktemp "$report_directory/.gh-aw-retry.XXXXXXXX")" || return
    if ! {
        printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
        printf 'arch=%q\nchina_mirror_requested=%q\n' "$arch" "$china_mirror_requested"
        declare -f die _wsl_cli_windows_path _wsl_cli_configure_path available \
            require_commands download_verified_archive install_gh_aw
        cat <<'RETRY'
block_step() { die "Blocked: $*"; }
_wsl_cli_configure_path
mkdir -p "$HOME/.local/state/wsl-bootstrap"
exec 9>"$HOME/.local/state/wsl-bootstrap/setup.lock"
flock -n 9 || die "Another udb run or gh-aw retry is active; finish it before retrying."
extension_stage=""
cleanup_gh_aw_retry() {
    local status=$?
    trap - EXIT
    if [[ -n "$extension_stage" && -d "$extension_stage" ]]; then
        rm -f -- "$extension_stage/gh-aw" "$extension_stage/manifest.yml" || status=1
        rmdir -- "$extension_stage" || status=1
    fi
    exit "$status"
}
trap cleanup_gh_aw_retry EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
install_gh_aw
RETRY
    } >"$staged"; then
        rm -f -- "$staged"
        return 1
    fi
    if ! bash -n "$staged" || ! mv -T -- "$staged" "$report_directory/gh-aw-retry.sh"; then
        rm -f -- "$staged"
        return 1
    fi
}

install_gh_aw() {
    require_commands gh
    local directory="${XDG_DATA_HOME:-$HOME/.local/share}/gh/extensions/gh-aw"
    local version=1.2.1 checksum
    if [[ -e "$directory" || -L "$directory" ]]; then
        if [[ -d "$directory" && ! -L "$directory" && ! -x "$directory/gh-aw" ]] \
            && rmdir -- "$directory" 2>/dev/null; then
            echo "Removed an empty leftover gh-aw directory; retrying the verified binary installation."
        else
            [[ -d "$directory" && -x "$directory/gh-aw" ]] \
                || die "Existing gh-aw is incomplete; its directory is nonempty, symlinked, or could not be removed safely. Keeping it unchanged. Inspect $directory before rerunning."
            available "$directory/gh-aw" || die "Existing gh-aw is not a native executable: $directory/gh-aw"
            echo "Keeping existing gh-aw: $directory"
            return
        fi
    fi
    require_commands curl sha256sum
    case "$arch" in
        amd64) checksum=84a8c2f8de3f5d3af681e4b3551b8ba47e18a2a2e660464142c12a63cf17bb66 ;;
        arm64) checksum=6af2d263c3aa9e9080797d7f8e9267ca42bceeca4ebc703949d05b61946bb240 ;;
        *) die "Unsupported gh-aw architecture: $arch" ;;
    esac
    echo "Installing missing gh-aw v$version (prerelease) from a verified Release binary; no clone, build, GitHub API or login is required."
    echo "Download mirror mode: $china_mirror_requested (1 = gh-proxy.org first, 0 = GitHub first)."
    mkdir -p "${directory%/*}"
    extension_stage="$(mktemp -d "${directory%/*}/.gh-aw-stage.XXXXXXXX")"
    download_verified_archive \
        "https://github.com/github/gh-aw/releases/download/v$version/linux-$arch" \
        "$checksum" "$extension_stage/gh-aw"
    chmod 0755 "$extension_stage/gh-aw"
    echo "Checking the downloaded gh-aw binary..."
    timeout --foreground --kill-after=3s 10s "$extension_stage/gh-aw" --version </dev/null \
        || die "The verified gh-aw binary is not usable on this system."
    # Use gh's binary-extension layout, avoiding login requirements and install scripts.
    cat > "$extension_stage/manifest.yml" <<EOF
owner: github
name: gh-aw
host: github.com
tag: v$version
ispinned: true
EOF
    [[ ! -e "$directory" && ! -L "$directory" ]] \
        || die "gh-aw appeared during installation; keeping it unchanged. Rerun setup."
    mv -T -- "$extension_stage" "$directory"
    extension_stage=""
    echo "Checking GitHub CLI extension dispatch: gh aw --version"
    GH_NO_EXTENSION_UPDATE_NOTIFIER=1 timeout --foreground --kill-after=3s 10s gh aw --version </dev/null \
        || die "gh-aw was installed but GitHub CLI could not run it; inspect $directory."
    echo "Installed verified gh-aw v$version without login changes."
}

install_azure_cli() {
    if check_existing az version --output json; then
        return
    fi
    require_step apt-update
    ensure_command gpg gnupg
    sudo -n install -d -m 0755 /etc/apt/keyrings
    echo "Installing missing Azure CLI..."
    download https://packages.microsoft.com/keys/microsoft.asc "$tmp/microsoft.asc"
    gpg --batch --yes --dearmor -o "$tmp/microsoft.gpg" "$tmp/microsoft.asc"
    publish_apt_file "$tmp/microsoft.gpg" /etc/apt/keyrings/microsoft.gpg
    cat > "$tmp/azure-cli.sources" <<EOF
Types: deb
URIs: https://packages.microsoft.com/repos/azure-cli/
Suites: ${VERSION_CODENAME}
Components: main
Architectures: ${arch}
Signed-by: /etc/apt/keyrings/microsoft.gpg
EOF
    publish_apt_file "$tmp/azure-cli.sources" /etc/apt/sources.list.d/azure-cli.sources
    invalidate_apt_metadata
    install_packages azure-cli
    available az || die "The Azure CLI package did not provide a native az executable."
    az version --output json
}

install_node() {
    if check_existing node --version; then
        return
    fi
    require_commands python3
    if (( china_mirror_requested == 1 )); then
        echo "Installing missing Node.js from the npmmirror LTS binary mirror..."
        install_node_from_mirror
    else
        require_step apt-update
        ensure_command gpg gnupg
        echo "Installing missing Node.js from the latest LTS release line..."
        download https://nodejs.org/dist/index.json "$tmp/node-index.json"
        node_major="$(python3 - "$tmp/node-index.json" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as stream:
    releases = json.load(stream)
versions = [
    tuple(int(part) for part in release["version"].removeprefix("v").split("."))
    for release in releases if release.get("lts")
]
if not versions:
    raise SystemExit("No LTS release found in the official Node.js index.")
print(max(versions)[0])
PY
)"
        [[ "$node_major" =~ ^[0-9]+$ ]] || die "Invalid Node.js LTS version."
        download https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key "$tmp/nodesource.asc"
        gpg --batch --yes --dearmor -o "$tmp/nodesource.gpg" "$tmp/nodesource.asc"
        publish_apt_file "$tmp/nodesource.gpg" /usr/share/keyrings/nodesource.gpg
        cat > "$tmp/nodesource.sources" <<EOF
Types: deb
URIs: https://deb.nodesource.com/node_${node_major}.x
Suites: nodistro
Components: main
Architectures: ${arch}
Signed-By: /usr/share/keyrings/nodesource.gpg
EOF
        publish_apt_file "$tmp/nodesource.sources" /etc/apt/sources.list.d/nodesource.sources
        cat > "$tmp/node-preferences" <<'EOF'
Package: nodejs
Pin: origin deb.nodesource.com
Pin-Priority: 600
EOF
        publish_apt_file "$tmp/node-preferences" /etc/apt/preferences.d/wsl-bootstrap-node
        invalidate_apt_metadata
        install_packages nodejs
    fi
    available node || die "Node installation did not provide a native node executable."
    node --version
}

install_npm() {
    require_commands node
    node --version >/dev/null
    ensure_command npm npm
}

check_copilot_version() {
    local executable="$1" status=0
    echo "Checking Copilot executable: $executable (15-second limit)"
    # Avoid terminal job-control stops and pipes held open by escaped descendants.
    timeout --foreground --kill-after=5s 15s "$executable" --version \
        </dev/null >"$tmp/copilot-version.log" 2>&1 || status=$?
    copilot_diagnostic="$(<"$tmp/copilot-version.log")"
    rm -f -- "$tmp/copilot-version.log"
    if (( status == 124 || status == 137 )); then
        printf 'Copilot version check timed out (exit %s): %s\n' "$status" "$executable" >&2
    fi
    return "$status"
}

install_workiq() {
    local executable="" resolved native node_arch version=1.0.1
    if available workiq; then
        executable="$(type -P workiq)"
    else
        [[ ! -e "$HOME/.local/bin/workiq" && ! -L "$HOME/.local/bin/workiq" ]] \
            || die "An unusable user-local WorkIQ entry already exists; inspect $HOME/.local/bin/workiq before rerunning."
        require_commands node npm
        if (( china_mirror_requested == 1 )); then
            require_step npm-mirror
        fi
        require_supported_node
        ensure_user_npm_prefix
        echo "Installing missing WorkIQ $version globally..."
        # All platform binaries are bundled; no lifecycle scripts or extra downloads are needed.
        retry "Installing WorkIQ $version" timeout --kill-after=5s 180s npm install \
            --global --engine-strict --ignore-scripts "@microsoft/workiq@$version"
        executable="$HOME/.local/bin/workiq"
    fi
    resolved="$(readlink -f -- "$executable")" || die "Cannot resolve WorkIQ executable: $executable"
    case "$resolved" in
        */node_modules/@microsoft/workiq/bin/workiq.js)
            require_commands node
            node_arch="$(node -p 'process.arch')"
            case "$node_arch" in
                x64|arm64) ;;
                *) die "Unsupported Node architecture for WorkIQ: $node_arch" ;;
            esac
            native="${resolved%/workiq.js}/linux-$node_arch/workiq"
            [[ -f "$native" && ! -L "$native" ]] \
                || die "The installed WorkIQ package has no native Linux binary: $native"
            [[ "$executable" == "$HOME/.local/bin/workiq" && -L "$executable" ]] \
                || die "WorkIQ's npm launcher selects Windows executables on WSL. Keep the existing package and point $HOME/.local/bin/workiq to $native manually; ensure it precedes $executable on PATH."
            chmod u+x -- "$native"
            # The upstream npm launcher selects Windows .exe files on WSL.
            ln -sfn -- "$native" "$executable"
            echo "Selected the bundled native Linux WorkIQ binary; package and account data are unchanged."
            ;;
    esac
    available "$executable" || die "WorkIQ is not a native Linux executable: $executable"
    timeout --foreground --kill-after=3s 15s "$executable" --version </dev/null \
        || die "Existing WorkIQ failed its version check; keeping the installation unchanged."
    echo "Keeping installed WorkIQ: $executable"
}

install_workiq_runtime() {
    install_packages libwebkit2gtk-4.1-0 libsecret-1-0
}

ensure_workiq_eula() {
    local status=0
    ( umask 077; : > "$tmp/workiq-config.log" )
    LC_ALL=C LANG=C timeout --foreground --kill-after=3s 15s workiq config show \
        </dev/null >"$tmp/workiq-config.log" 2>&1 || status=$?
    if (( status != 0 )); then
        rm -f -- "$tmp/workiq-config.log"
        die "Cannot check WorkIQ EULA configuration (exit $status); existing settings were not changed."
    fi
    if grep -qx 'I-accept-EULA=true' "$tmp/workiq-config.log"; then
        rm -f -- "$tmp/workiq-config.log"
        echo "WorkIQ EULA is already accepted; skipping acceptance."
        return
    fi
    rm -f -- "$tmp/workiq-config.log"
    echo "Accepting the WorkIQ EULA: workiq accept-eula"
    LC_ALL=C LANG=C timeout --foreground --kill-after=3s 15s workiq accept-eula </dev/null \
        || die "WorkIQ EULA acceptance failed; login was not started."
    LC_ALL=C LANG=C timeout --foreground --kill-after=3s 15s workiq config show \
        </dev/null >"$tmp/workiq-config.log" 2>&1 || status=$?
    if (( status != 0 )) || ! grep -qx 'I-accept-EULA=true' "$tmp/workiq-config.log"; then
        rm -f -- "$tmp/workiq-config.log"
        die "WorkIQ EULA acceptance could not be verified; login was not started."
    fi
    rm -f -- "$tmp/workiq-config.log"
}

install_copilot() {
    local copilot_repair=0 copilot_version="" copilot_diagnostic node_arch copilot_status=0
    if available copilot; then
        if check_copilot_version "$(type -P copilot)"; then
            echo "Keeping existing copilot: $(type -P copilot)"
            return
        else
            copilot_status=$?
        fi
        printf '%s\n' "$copilot_diagnostic" >&2
        (( copilot_status != 124 && copilot_status != 137 )) \
            || die "Existing Copilot version check timed out; keeping the installation unchanged. Inspect the task log and retry copilot --version manually."
        [[ "$copilot_diagnostic" == *"no platform package found"* ]] \
            || die "Existing Copilot has an unrecognized error; refusing to replace it automatically."
        copilot_repair=1
    fi
    require_commands node npm python3
    if (( china_mirror_requested == 1 )); then
        require_step npm-mirror
    fi
    require_supported_node
    if (( copilot_repair == 1 )); then
        case "$(readlink -f "$(type -P copilot)")" in
            "$HOME/.local/lib/node_modules/@github/copilot/"*) ;;
            *) die "Broken Copilot is outside the managed npm prefix; repair it using its original package manager." ;;
        esac
        copilot_version="$(python3 - "$(type -P copilot)" <<'PY'
import json
from pathlib import Path
import sys

executable = Path(sys.argv[1]).resolve(strict=True)
for parent in executable.parents:
    manifest = parent / "package.json"
    if manifest.is_file():
        package = json.loads(manifest.read_text(encoding="utf-8"))
        if package.get("name") == "@github/copilot":
            print(package["version"])
            break
else:
    raise SystemExit("Cannot identify the broken Copilot version; repair it manually.")
PY
)"
    fi
    ensure_user_npm_prefix
    node_arch="$(node -p 'process.arch')"
    case "$node_arch" in
        x64|arm64) ;;
        *) die "Unsupported Node architecture for Copilot: $node_arch" ;;
    esac
    if [[ -z "$copilot_version" ]]; then
        copilot_version="$(retry "Reading the Copilot version" timeout --kill-after=5s 45s npm view @github/copilot version)"
    fi
    [[ "$copilot_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
        || die "Invalid Copilot version: $copilot_version"
    if (( copilot_repair == 1 )); then
        echo "Repairing Copilot $copilot_version without upgrading it; account settings are preserved."
        timeout --kill-after=5s 60s npm uninstall --global --ignore-scripts \
            @github/copilot "@github/copilot-linux-$node_arch"
    else
        echo "Installing missing Copilot $copilot_version and its Linux platform package..."
    fi
    # A required platform dependency makes download failures fatal instead of silently optional.
    retry "Installing Copilot $copilot_version" timeout --kill-after=5s 180s npm install --global --include=optional --ignore-scripts=false \
        --os=linux "--cpu=$node_arch" --libc=glibc \
        "@github/copilot@$copilot_version" "@github/copilot-linux-$node_arch@$copilot_version"
    hash -r
    if check_copilot_version "$HOME/.local/bin/copilot"; then
        printf '%s\n' "$copilot_diagnostic"
    else
        printf '%s\n' "$copilot_diagnostic" >&2
        die "Copilot is still unusable after installation. Check the task log, native binary permissions and platform compatibility."
    fi
}

configure_bash() {
    require_commands python3
    {
        declare -f _wsl_cli_windows_path _wsl_cli_configure_path
        echo '_wsl_cli_configure_path'
        echo 'unset -f _wsl_cli_windows_path _wsl_cli_configure_path'
        cat <<'MIRROR_SOURCE'
if [[ -f "$HOME/.local/share/wsl-bootstrap/china-mirrors.sh" ]]; then
    source "$HOME/.local/share/wsl-bootstrap/china-mirrors.sh"
fi
MIRROR_SOURCE
        if (( is_wsl == 1 )) && [[ -x "$HOME/.local/bin/wsl-browser" ]]; then
            cat <<'BASHRC'
export BROWSER="$HOME/.local/bin/wsl-browser"
export GH_BROWSER="$BROWSER"
BASHRC
        fi
    } > "$tmp/config-block"
    write_managed_block "$HOME/.bashrc" "native PATH"
    configure_copilot_aliases "$HOME/.bashrc"
    bash -n "$HOME/.bashrc"
    hash -r
    echo "Bash compatibility settings saved."
}

try_interactive_login() {
    guide_login "$@"
    case "$login_command_status" in
        0) return ;;
        2)
            echo "Login skipped by the user." > "$report_directory/$current_step.skipped"
            exit 0
            ;;
        *) die "$1 login failed; use the manual retry command shown above." ;;
    esac
}

authenticate_service() {
    local label="$1" probe="$2" status=0
    shift 2
    "$probe" || status=$?
    case "$status" in
        0) echo "$label has usable credentials; keeping the active account." ;;
        1)
            try_interactive_login "$label" "$@"
            "$probe" || die "$label login completed but usable credentials could not be verified."
            ;;
        *) die "$label credential validation failed; resolve network/account errors before retrying. Saved accounts were not replaced." ;;
    esac
}

login_github() {
    require_commands gh git
    echo "Manual retry if needed: gh auth login --hostname github.com -p ssh --web"
    authenticate_service "GitHub CLI" github_is_logged_in \
        timeout --foreground --kill-after=5s 300s gh auth login --hostname github.com -p ssh --web
    configure_git_identity
}

login_azure() {
    require_commands az
    printf 'Manual retry if needed: az login'
    if (( ${#azure_login_arguments[@]} > 0 )); then
        printf ' %q' "${azure_login_arguments[@]}"
    fi
    printf '\n'
    authenticate_service "Azure CLI" azure_is_logged_in \
        timeout --foreground --kill-after=5s 300s az login "${azure_login_arguments[@]}"
}

login_copilot() {
    require_commands copilot gh
    local github_status=0 status=0
    echo "Manual retry if needed: copilot login --device-code (requires a working system keyring)"
    if [[ "${step_status[login-github]:-not-run}" != success ]]; then
        github_is_logged_in || github_status=$?
    fi
    copilot_is_logged_in "$github_status" || status=$?
    case "$status" in
        0) echo "Copilot can reuse existing credentials; permissions/subscription are checked when used." ;;
        1) try_interactive_login "Copilot CLI" copilot_login_secure ;;
        *) die "Copilot credential validation failed; saved accounts were not replaced." ;;
    esac
}

login_workiq() {
    require_commands workiq tee grep
    local status=0
    ensure_workiq_eula
    echo "Manual retry if needed: workiq auth login"
    echo "WorkIQ reuses cached credentials first; interactive sign-in is only needed when they are unavailable."
    # WorkIQ 1.0.1 may print a login failure and still exit zero.
    # Keep authentication output on the terminal, not in persistent task logs.
    ( umask 077; : > "$tmp/workiq-login.log" )
    LC_ALL=C LANG=C timeout --foreground --kill-after=5s 300s workiq auth login \
        2>&1 | tee "$tmp/workiq-login.log" || status=$?
    if (( status == 0 )) && grep -q '^Logged in as .' "$tmp/workiq-login.log" \
        && ! grep -q 'Login failed:' "$tmp/workiq-login.log"; then
        rm -f -- "$tmp/workiq-login.log"
        echo "WorkIQ credentials verified; the active account is retained."
        return
    fi
    rm -f -- "$tmp/workiq-login.log"
    echo "WebKit/libsecret packages were checked before login. If the broker still fails, inspect the displayed error; workiq config set disableBrokeredAuth=true selects browser authentication." >&2
    die "WorkIQ login was not confirmed (exit $status). Existing credentials/configuration were not reset; use the manual retry command."
}

[[ -x /usr/bin/flock ]] || die "Native flock is required (Ubuntu util-linux)."
mkdir -p "$HOME/.local/state/wsl-bootstrap"
exec 9>"$HOME/.local/state/wsl-bootstrap/setup.lock"
/usr/bin/flock -n 9 || die "Another udb run is active for this user; finish it before rerunning."
report_directory="$(umask 077; mkdir -p "$HOME/.local/state/wsl-bootstrap"; \
    /usr/bin/mktemp -d "$HOME/.local/state/wsl-bootstrap/run-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXXXX")"
echo "Per-task logs: $report_directory"
write_mirror_config_helper

run_step sudo "Authorizing sudo and checking its policy" "" authorize_sudo
run_step sudo-policy "Checking the requested WSL passwordless-sudo policy" "sudo" configure_sudo_policy
run_step github-source-migration "Checking the legacy GitHub CLI apt source" "" retire_missing_github_cli_source
run_step apt-sources "Configuring requested apt mirrors" "" configure_china_apt_sources
run_step apt-update "Updating apt package metadata" "sudo apt-sources" prepare_apt
run_step apt-upgrade "Upgrading installed apt packages" "apt-update" upgrade_apt_packages
