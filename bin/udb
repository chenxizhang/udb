    python3 -c 'import sys; assert sys.version_info.major == 3, "Python 3 is required"'
}

install_python_alias() {
    ensure_command python python-is-python3
    python -c 'import sys; assert sys.version_info.major == 3, "Existing python is not Python 3; repair its mapping explicitly"'
}

