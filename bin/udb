run_step pip-mirror "Configuring the requested pip mirror" "" configure_pip_mirror
run_step node-mirrors "Saving requested Node mirror environment" "" configure_node_mirror_environment
if (( workiq_requested == 1 )); then
    run_step workiq "Checking or installing global WorkIQ" "" install_workiq
    run_step workiq-runtime "Checking WorkIQ WebKit and libsecret libraries" "workiq" install_workiq_runtime
else
    skip_step workiq "Checking or installing global WorkIQ" "$workiq_skip_reason"
    skip_step workiq-runtime "Checking WorkIQ WebKit and libsecret libraries" "$workiq_skip_reason"
fi
run_step copilot "Checking or installing Copilot" "" install_copilot
run_step agent-browser "Checking or installing agent-browser CLI" "" install_agent_browser
run_step agent-browser-skill "Checking or installing the global agent-browser skill for GitHub Copilot" "" install_agent_browser_skill
run_step web-instructions "Saving Copilot local web validation instructions" "" configure_web_instructions
run_step bash "Configuring Bash PATH and Copilot shortcuts" "python3" configure_bash
run_step zsh "Checking native zsh" "" ensure_command zsh zsh
run_step autosuggestions "Installing pinned zsh history suggestions" "" \
    install_zsh_plugin zsh-autosuggestions e52ee8ca55bcc56a17c828767a3f98f22a68d4eb
run_step highlighting "Installing pinned zsh syntax highlighting" "" \
    install_zsh_plugin zsh-syntax-highlighting db085e4661f6aafd24e5acb5b2e17e4dd5dddf3e
run_step zsh-config "Configuring interactive zsh completion and plugins" "zsh python3 autosuggestions highlighting" configure_zsh
run_step zsh-check "Verifying login and non-login zsh functionality" "zsh-config" verify_zsh
run_step login-shell "Setting the verified zsh as the default login shell" "zsh-check" set_default_zsh
run_step tmux "Checking stable tmux" "" ensure_command tmux tmux -V
run_step tmux-config "Configuring tmux to use the verified zsh" "tmux zsh-check" configure_tmux
run_step docker "Checking Docker Engine" "" configure_docker
run_step docker-compose "Checking Docker Compose" "" install_docker_plugin compose
run_step docker-buildx "Checking Docker Buildx" "" install_docker_plugin buildx
run_step automation-browser "Checking or installing the default automation browser and Linux libraries" "agent-browser" configure_agent_browser

if (( login_requested == 1 )) && ( : </dev/tty ) 2>/dev/null; then
    run_step login-github "Checking GitHub login and Git identity" "" login_github
    run_step login-azure "Checking Azure login" "" login_azure
    run_step login-copilot "Checking Copilot login" "" login_copilot
    if (( workiq_requested == 1 )); then
        run_step login-workiq "Checking WorkIQ EULA and login (reusing cached credentials)" "workiq workiq-runtime" login_workiq
    else
        skip_step login-workiq "Checking WorkIQ EULA and login" "$workiq_skip_reason"
    fi
else
    skip_step login-github "Checking GitHub login and Git identity" "Login disabled or no controlling terminal."
    skip_step login-azure "Checking Azure login" "Login disabled or no controlling terminal."
    skip_step login-copilot "Checking Copilot login" "Login disabled or no controlling terminal."
    if (( workiq_requested == 1 )); then
        skip_step login-workiq "Checking WorkIQ login" "Login disabled or no controlling terminal."
    else
        skip_step login-workiq "Checking WorkIQ EULA and login" "$workiq_skip_reason"
    fi
    echo "Manual login: gh auth login --hostname github.com -p ssh --web"
    printf 'Manual login: az login'
    if (( ${#azure_login_arguments[@]} > 0 )); then
        printf ' %q' "${azure_login_arguments[@]}"
    fi
    printf '\n%s\n' "Manual login: copilot login --device-code (requires a working system keyring)"
    if (( workiq_requested == 1 )); then
        echo "Manual login: workiq auth login"
    fi
fi

print_setup_summary | tee "$report_directory/summary.txt"
if [[ -f "$run_state/docker-restart-required" ]]; then
    echo "WSL systemd is configured for the next boot; restart this distro from Windows when convenient."
fi
if [[ -e /var/run/reboot-required ]]; then
    echo "Package upgrades require a restart; schedule it when convenient. Setup never restarts automatically."
fi
if [[ "${step_status[zsh-check]}" == success ]]; then
    echo "Zsh plugins are verified. Existing shells/tmux servers are not reloaded; use a NEW session or: exec zsh -l"
    echo "History suggestions appear after typing a prefix of a command present in that user's zsh history."
fi
echo "New Docker group membership also needs a fresh login session."
incomplete_steps=0
for step in "${step_order[@]}"; do
    if [[ "${step_status[$step]}" == failed || "${step_status[$step]}" == blocked ]]; then
        incomplete_steps=$((incomplete_steps + 1))
    fi
done
if (( incomplete_steps > 0 )); then
    die "$incomplete_steps task(s) failed or were blocked. Independent tasks were still attempted; use the manual commands in summary.txt to repair individual steps, or rerun setup after fixing the reported causes."
fi
echo "All requested setup tasks completed; explicitly skipped login steps are listed above."
if [[ "${step_status[zsh-check]}" == success && -t 1 && -t 2 ]] && ( : </dev/tty ) 2>/dev/null; then
    echo "Entering the verified interactive login zsh."
    cleanup
    trap - EXIT
    exec 9>&-
    exec zsh -il </dev/tty
fi
